    <id>UMLNote</id>
    <coordinates><x>660</x><y>1380</y><w>260</w><h>150</h></coordinates>
    <panel_attributes>MarginFloorPolicy is the Anti-
Corruption Layer: it decides
identically for a HUMAN and an AGENT
proposal, and activate() takes its
assessment so the aggregate never
recomputes a margin (spec-03 s3,
B-3/B-6).
bg=#FFFBE6</panel_attributes>
    <additional_attributes/>
  </element>
