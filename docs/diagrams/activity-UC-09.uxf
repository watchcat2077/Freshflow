<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>Text</id>
    <coordinates><x>0</x><y>0</y><w>1080</w><h>30</h></coordinates>
    <panel_attributes>UC-09 Observe the rolling sell-through velocity of a SKU (FR12, real-time analysis)
fontsize=16</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLObject</id>
    <coordinates><x>0</x><y>40</y><w>240</w><h>1220</h></coordinates>
    <panel_attributes>Kafka
valign=top
layer=-1</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLObject</id>
    <coordinates><x>240</x><y>40</y><w>560</w><h>1220</h></coordinates>
    <panel_attributes>insight-service (Kafka Streams topology; Interactive Query)
valign=top
layer=-1</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLObject</id>
    <coordinates><x>800</x><y>40</y><w>280</w><h>1220</h></coordinates>
    <panel_attributes>Shift supervisor
(or the agent's getSellThroughRate tool)
valign=top
layer=-1</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>110</x><y>110</y><w>20</w><h>20</h></coordinates>
    <panel_attributes>type=initial</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLObject</id>
    <coordinates><x>20</x><y>200</y><w>200</w><h>60</h></coordinates>
    <panel_attributes>&lt;&lt;event&gt;&gt;
item-sold
(occurredAt set by producer)
bg=#F4F4F4</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>260</x><y>200</y><w>240</w><h>60</h></coordinates>
    <panel_attributes>Consume item-sold;
assign it to windows
by its occurredAt
type=receiver</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>360</x><y>300</y><w>40</w><h>40</h></coordinates>
    <panel_attributes>type=decision</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>560</x><y>300</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Count it in the window its
occurredAt belongs to (1a)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>260</x><y>400</y><w>240</w><h>50</h></coordinates>
    <panel_attributes>Group by SKU; sum quantity per
hopping window (60 s, step 5 s)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>260</x><y>500</y><w>240</w><h>50</h></coordinates>
    <panel_attributes>Join the windowed total with
the SKU's baseline (KTable)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>260</x><y>600</y><w>240</w><h>60</h></coordinates>
    <panel_attributes>Keep the latest closed window
per SKU in the state store
(velocity/h, ratio to baseline)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>830</x><y>700</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Request the velocity
for a SKU</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>260</x><y>800</y><w>240</w><h>50</h></coordinates>
    <panel_attributes>Look up the SKU in the
velocity state store</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>360</x><y>900</y><w>40</w><h>40</h></coordinates>
    <panel_attributes>type=decision</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>560</x><y>900</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Answer 404: no closed window,
or it has aged out</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>660</x><y>975</y><w>20</w><h>20</h></coordinates>
    <panel_attributes>type=final</panel_attributes>
    <additional_attributes/>
  </element>
