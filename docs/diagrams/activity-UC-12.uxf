<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>Text</id>
    <coordinates><x>0</x><y>0</y><w>1380</w><h>30</h></coordinates>
    <panel_attributes>UC-12 Produce the end-of-day briefing (FR15, agentic AI)
fontsize=16</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLObject</id>
    <coordinates><x>0</x><y>40</y><w>260</w><h>2020</h></coordinates>
    <panel_attributes>Store owner
valign=top
layer=-1</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLObject</id>
    <coordinates><x>260</x><y>40</y><w>560</w><h>2020</h></coordinates>
    <panel_attributes>insight-service (briefing orchestrator and its tools)
valign=top
layer=-1</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLObject</id>
    <coordinates><x>820</x><y>40</y><w>560</w><h>2020</h></coordinates>
    <panel_attributes>Briefing Agent (LLM)
valign=top
layer=-1</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>120</x><y>110</y><w>20</w><h>20</h></coordinates>
    <panel_attributes>type=initial</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>20</x><y>200</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Request the briefing for a
business date (default today)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>380</x><y>300</y><w>40</w><h>40</h></coordinates>
    <panel_attributes>type=decision</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>580</x><y>300</y><w>220</w><h>60</h></coordinates>
    <panel_attributes>Answer 503
AGENT_NOT_CONFIGURED
(Pre)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>680</x><y>385</y><w>20</w><h>20</h></coordinates>
