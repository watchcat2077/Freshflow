  <element>
    <id>UMLNote</id>
    <coordinates><x>20</x><y>800</y><w>540</w><h>90</h></coordinates>
    <panel_attributes>The snapshot is fed only by price-rule-published and markdown-applied events
from pricing-service, through the PriceSnapshotFeed port; sales-service makes
no synchronous call to pricing-service (spec-01 s1.3). A window that has ended
(2b) falls into [none in force]: the base price returns without any further
event.
bg=#FFFBE6</panel_attributes>
    <additional_attributes/>
  </element>
