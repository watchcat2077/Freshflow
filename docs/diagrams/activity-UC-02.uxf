    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>260</x><y>900</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Reduce each affected batch;
at zero it becomes DEPLETED</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>260</x><y>1000</y><w>220</w><h>50</h></coordinates>
