    <id>UMLObject</id>
    <coordinates><x>20</x><y>200</y><w>200</w><h>60</h></coordinates>
    <panel_attributes>&lt;&lt;event&gt;&gt;
item-sold
(eventId, sku, quantity)
bg=#F4F4F4</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>260</x><y>200</y><w>220</w><h>40</h></coordinates>
    <panel_attributes>Receive item-sold event
type=receiver</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>260</x><y>300</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Check the eventId has
