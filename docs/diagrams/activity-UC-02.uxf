    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>350</x><y>400</y><w>40</w><h>40</h></coordinates>
    <panel_attributes>type=decision</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>540</x><y>400</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Ignore the redelivery;
deduct and publish nothing</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>640</x><y>475</y><w>20</w><h>20</h></coordinates>
