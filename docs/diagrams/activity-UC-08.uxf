<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>Text</id>
    <coordinates><x>0</x><y>0</y><w>1060</w><h>30</h></coordinates>
    <panel_attributes>UC-08 Reject a markdown that breaches the margin floor (FR11)
fontsize=16</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLObject</id>
    <coordinates><x>0</x><y>40</y><w>520</w><h>1020</h></coordinates>
    <panel_attributes>pricing-service: application layer
valign=top
layer=-1</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLObject</id>
    <coordinates><x>520</x><y>40</y><w>540</w><h>1020</h></coordinates>
    <panel_attributes>pricing-service: domain layer
(MarginFloorPolicy, MarkdownPlan)
valign=top
layer=-1</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>120</x><y>110</y><w>20</w><h>20</h></coordinates>
    <panel_attributes>type=initial</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>20</x><y>200</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Pass the price rule and the
requested tier to the policy</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>540</x><y>200</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Compute the resulting price:
base x (1 - tier %), to cents</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>540</x><y>300</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Compute the resulting margin:
(price - unit cost) / price</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>540</x><y>400</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Compare the ratio with
the SKU's margin floor</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>630</x><y>500</y><w>40</w><h>40</h></coordinates>
    <panel_attributes>type=decision</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates><x>820</x><y>500</y><w>220</w><h>50</h></coordinates>
    <panel_attributes>Assessment passes: UC-07
continues at its step 5</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>920</x><y>575</y><w>20</w><h>20</h></coordinates>
    <panel_attributes>type=final</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
