<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>com.freshflow</groupId>
  <artifactId>freshflow</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>FreshFlow</name>
  <description>Real-Time Expiry Risk Detection and Agentic Markdown Decision Support</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!--
      Spring Cloud release train for Spring Boot 3.4.x. It supplies the versions of
      spring-cloud-stream and the Kafka binder, both of which spec-01 s1.1 lists as
      mandatory stack elements (Event binding: Spring Cloud Stream (Kafka binder)).
      A BOM manages versions; it adds no dependency of its own.
    -->
    <spring-cloud.version>2024.0.0</spring-cloud.version>

    <!--
      spec-01 s1.1: LLM integration - LangChain4j. Team ruling R2 admits exactly two artifacts,
      langchain4j-core plus one provider module, and this property is what stops the two drifting
      apart: both are declared below without a version, so neither module pom can pin one of its
      own. The provider module already depends on core at the same version, so a mismatch here
      would be a diamond rather than a choice.
    -->
    <langchain4j.version>1.20.0</langchain4j.version>
  </properties>

  <!-- spec-01 s1.2 service topology plus supporting modules -->
  <modules>
    <module>contracts</module>
    <module>inventory-service</module>
    <module>sales-service</module>
    <module>pricing-service</module>
    <module>insight-service</module>
    <module>pos-simulator</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.freshflow</groupId>
        <artifactId>contracts</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- spec-01 s1.1: Event binding - Spring Cloud Stream (Kafka binder) -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- spec-01 s1.1: LLM integration - LangChain4j (FR14). Two artifacts, per R2. -->
      <dependency>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-core</artifactId>
        <version>${langchain4j.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-google-ai-gemini</artifactId>
        <version>${langchain4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>
