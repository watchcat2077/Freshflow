<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.freshflow</groupId>
    <artifactId>freshflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>insight-service</artifactId>
  <name>insight-service</name>
  <description>Insight bounded context. Port 8084. CQRS read side, no domain layer (spec-01 s2.3).</description>

  <dependencies>
    <!-- Published Language: shared event contract (spec-01 s1.5) -->
    <dependency>
      <groupId>com.freshflow</groupId>
      <artifactId>contracts</artifactId>
    </dependency>

    <!-- spec-01 s1.1: Web layer -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- spec-01 s1.1: Persistence, one H2 instance per service (s1.3) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- spec-01 s1.1: Event binding - Spring Cloud Stream with the Kafka binder.
         Used here for the StreamBridge producer that seeds the velocity-baseline topic. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-stream</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-stream-binder-kafka</artifactId>
    </dependency>

    <!-- spec-01 s1.1: Stream processing - Kafka Streams (FR12).
         This artifact is the intersection of the two rows spec-01 s1.1 already lists: it IS
         the Spring Cloud Stream Kafka binder for Kafka Streams, and it brings
         org.apache.kafka:kafka-streams transitively. It also supplies InteractiveQueryService,
         which is what spec-04 names for GET /api/insight/velocity/{sku}. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-stream-binder-kafka-streams</artifactId>
    </dependency>

    <!-- spec-01 s1.1: Testing (MockMvc) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
