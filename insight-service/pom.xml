<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.freshflow</groupId>
    <artifactId>freshflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>insight-service</artifactId>
  <name>insight-service</name>
  <description>Insight bounded context. Port 8084. CQRS read side with a small domain package (spec-01 s2.3, ADR 0006).</description>

  <dependencies>
    <!-- Published Language: shared event contract (spec-01 s1.5) -->
    <dependency>
      <groupId>com.freshflow</groupId>
      <artifactId>contracts</artifactId>
    </dependency>

    <!-- spec-01 s1.1: Web layer -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- spec-01 s1.1: Persistence, one H2 instance per service (s1.3) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- spec-01 s1.1: Event binding - Spring Cloud Stream with the Kafka binder.
         Used here for the StreamBridge producer that seeds the velocity-baseline topic. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-stream</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-stream-binder-kafka</artifactId>
    </dependency>

    <!-- spec-01 s1.1: Stream processing - Kafka Streams (FR12).
         This artifact is the intersection of the two rows spec-01 s1.1 already lists: it IS
         the Spring Cloud Stream Kafka binder for Kafka Streams, and it brings
         org.apache.kafka:kafka-streams transitively. It also supplies InteractiveQueryService,
         which is what spec-04 names for GET /api/insight/velocity/{sku}. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-stream-binder-kafka-streams</artifactId>
    </dependency>

    <!-- spec-01 s1.1: LLM integration - LangChain4j (FR14, ADR 0004).
         Exactly two artifacts, which is team ruling R2: langchain4j-core for the chat, message
         and tool-specification types, plus ONE provider module. A second provider artifact is a
         HALT, not a choice. Versions are managed in the root pom so the two cannot drift.

         Declared here at compile scope, which puts LangChain4j on the test classpath as well.
         That is a Maven fact and not a relaxation of ADR 0004: no test constructs a live model,
         no test imports dev.langchain4j, and the only MarkdownDecisionAgent any test sees is
         StubMarkdownDecisionAgent in test sources. See docs/ai-log/2026-09-10-fr14-phase-b2.md.

         The provider module brings langchain4j-http-client and langchain4j-http-client-jdk
         transitively. Neither is a provider module and neither is declared here; they are the
         HTTP plumbing the one approved provider is built on. -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-google-ai-gemini</artifactId>
    </dependency>

    <!-- spec-01 s1.1: Testing (MockMvc) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- spec-01 s1.1: Testing - TopologyTestDriver for the Kafka Streams topology (FR12, FR13).
         Approved by the subject coordinator by email on 17 September 2026. Test scope only; the
         version is managed by Spring Boot's dependency management alongside kafka-streams itself,
         so the driver and the library it drives cannot drift apart. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-streams-test-utils</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
